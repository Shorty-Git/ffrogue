{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ffrogue-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "ffrogue-review",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--host",
        "127.0.0.1",
        "--port",
        "3001",
        "--strictPort"
      ],
      "port": 3001
    },
    {
      "name": "ffrogue-polish",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "../ffrogue-polish",
        "--host",
        "127.0.0.1",
        "--port",
        "3002",
        "--strictPort"
      ],
      "port": 3002
    },
    {
      "name": "ffrogue-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--host",
        "127.0.0.1",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}
